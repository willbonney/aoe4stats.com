<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class={"text-4xl font-bold mb-2 #{text_heading()}"}>
      <%= case @active_tab do %>
        <% "per_capita" -> %>
          Conquerors Per Capita
        <% "avg_rank" -> %>
          Average Rank by Country
        <% "prowess" -> %>
          National Prowess Index
        <% "conqueror3" -> %>
          Conqueror 3+ Players by Country
        <% "top100" -> %>
          Top 100 Players by Country
        <% _ -> %>
          Conqueror Players by Country
      <% end %>
    </h1>
    <p class={"text-lg #{text_subtle()}"}>
      <%= case @active_tab do %>
        <% "per_capita" -> %>
          Conqueror players (1400+) per million population
        <% "avg_rank" -> %>
          Countries ranked by average leaderboard position
        <% "prowess" -> %>
          Rank-weighted per capita score combining player quality and quantity
        <% "conqueror3" -> %>
          Country distribution of all players with rating above 1600
        <% "top100" -> %>
          Country distribution of the top 100 players
        <% _ -> %>
          Country distribution of all players with rating above 1400
      <% end %>
    </p>
  </div>

  <%= if @loading do %>
    <div class="flex flex-col items-center justify-center py-12">
      <div class={"animate-spin rounded-full h-16 w-16 border-b-2 #{text_heading()}"}>
      </div>
      <p class={"mt-4 #{text_subtle()}"}>Loading leaderboard data...</p>
    </div>
  <% end %>

  <%= if @error do %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-red-800 dark:text-red-200 mb-2">
        Error Loading Data
      </h2>
      <p class="text-red-600 dark:text-red-300"><%= @error %></p>
    </div>
  <% end %>

  <%= if !@loading && !@error do %>
    <%
      current_data = case @active_tab do
        "conqueror" -> @conqueror_data
        "conqueror3" -> @conqueror3_data
        "top100" -> @top100_data
        "per_capita" -> @per_capita_data
        "avg_rank" -> @avg_rank_data
        "prowess" -> @prowess_data
        _ -> @conqueror_data
      end
    %>
    
    <.card class="mb-8">
      <h2 class={"text-2xl font-bold mb-4 #{text_heading()}"}>
        Statistics
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <%= if @active_tab == "per_capita" do %>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Countries with Data</p>
            <p class={"text-3xl font-bold #{text_heading()}"}>
              <%= format_number(current_data.total) %>
            </p>
          </div>
        <% end %>
        <%= if @active_tab == "avg_rank" do %>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Countries Ranked</p>
            <p class={"text-3xl font-bold #{text_heading()}"}>
              <%= format_number(current_data.total) %>
            </p>
          </div>
        <% end %>
        <%= if @active_tab == "prowess" do %>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Countries Ranked</p>
            <p class={"text-3xl font-bold #{text_heading()}"}>
              <%= format_number(current_data.total) %>
            </p>
          </div>
        <% end %>
        <%= if @active_tab not in ["per_capita", "avg_rank", "prowess"] do %>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Total Players</p>
            <p class={"text-3xl font-bold #{text_heading()}"}>
              <%= format_number(current_data.total) %>
            </p>
          </div>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Countries Represented</p>
            <p class={"text-3xl font-bold #{text_heading()}"}>
              <%= map_size(current_data.distribution) %>
            </p>
          </div>
        <% end %>
        <%= if @last_updated do %>
          <div>
            <p class={"text-sm #{text_subtle()}"}>Last Updated</p>
            <p class={"text-sm #{text_heading()}"}>
              <%= format_timestamp(@last_updated) %>
            </p>
          </div>
        <% end %>
      </div>
    </.card>

    <div class={"mb-6 border-b #{border_divider()}"}>
      <nav class="flex space-x-8" aria-label="Tabs">
        <.tab_button phx_click="switch_tab" phx_value_tab="conqueror" active={@active_tab == "conqueror"}>
          Conqueror (1400+)
        </.tab_button>
        <.tab_button phx_click="switch_tab" phx_value_tab="conqueror3" active={@active_tab == "conqueror3"}>
          Conqueror 3+ (2000+)
        </.tab_button>
        <.tab_button phx_click="switch_tab" phx_value_tab="top100" active={@active_tab == "top100"}>
          Top 100
        </.tab_button>
        <.tab_button phx_click="switch_tab" phx_value_tab="per_capita" active={@active_tab == "per_capita"}>
          Per Capita
        </.tab_button>
        <.tab_button phx_click="switch_tab" phx_value_tab="avg_rank" active={@active_tab == "avg_rank"}>
          Average Rank
        </.tab_button>
        <.tab_button phx_click="switch_tab" phx_value_tab="prowess" active={@active_tab == "prowess"}>
          National Prowess
        </.tab_button>
      </nav>
    </div>

    <!-- Chart Card (hidden for per capita, avg rank, and prowess) -->
    <%= if @active_tab not in ["per_capita", "avg_rank", "prowess"] do %>
      <.card class="mb-8">
        <div class="relative" style="height: 700px;">
          <canvas
            id="leaderboard-countries-chart"
            phx-hook="LeaderboardCountries"
            phx-update="ignore"
          >
          </canvas>
        </div>
      </.card>
    <% end %>

    <%= if @active_tab == "avg_rank" && length(@avg_rank_data.ranked) > 0 do %>
      <.card class="overflow-hidden">
        <.simple_table>
          <.simple_table_head>
            <.simple_table_header_cell>Rank</.simple_table_header_cell>
            <.simple_table_header_cell>Country</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Players</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Avg Rank</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Best Rank</.simple_table_header_cell>
          </.simple_table_head>
          <.simple_table_body>
            <%= for {item, index} <- Enum.with_index(@avg_rank_data.ranked, 1) do %>
              <.simple_table_row>
                <.simple_table_cell class="font-medium">#<%= index %></.simple_table_cell>
                <.simple_table_cell>
                  <div class=" flex flex-row items-center">
                  <span class="mr-2 text-2xl"><%= WololoWeb.PlayerLive.get_country_code_emoji(item.country) %></span>
                  <%= get_country_name(item.country) %>
                  </div>
                </.simple_table_cell>
                <.simple_table_cell align="right"><%= format_number(item.player_count) %></.simple_table_cell>
                <.simple_table_cell align="right" class="font-semibold #{text_heading()}">
                  #<%= format_number(trunc(item.avg_rank)) %>
                </.simple_table_cell>
                <.simple_table_cell align="right" class={text_muted()}>
                  #<%= format_number(item.best_rank) %>
                </.simple_table_cell>
              </.simple_table_row>
            <% end %>
          </.simple_table_body>
        </.simple_table>
      </.card>
    <% end %>

    <%= if @active_tab == "per_capita" && Map.has_key?(@per_capita_data, :ranked) do %>
      <.card class="overflow-hidden">
        <.simple_table>
          <.simple_table_head>
            <.simple_table_header_cell>Rank</.simple_table_header_cell>
            <.simple_table_header_cell>Country</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Players</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Per Million</.simple_table_header_cell>
          </.simple_table_head>
          <.simple_table_body>
            <%= for {item, index} <- Enum.with_index(@per_capita_data.ranked, 1) do %>
              <.simple_table_row>
                <.simple_table_cell class="font-medium">#<%= index %></.simple_table_cell>
                <.simple_table_cell>
                <div class=" flex flex-row items-center">
                    <span class="mr-2 text-2xl"><%= WololoWeb.PlayerLive.get_country_code_emoji(item.country) %></span>
                    <%= get_country_name(item.country) %>
                  </div>
                </.simple_table_cell>
                <.simple_table_cell align="right"><%= format_number(item.count) %></.simple_table_cell>
                <.simple_table_cell align="right" class="font-semibold #{text_heading()}">
                  <%= item.per_capita %>
                </.simple_table_cell>
              </.simple_table_row>
            <% end %>
          </.simple_table_body>
        </.simple_table>
      </.card>
    <% end %>

    <%= if @active_tab == "prowess" && length(@prowess_data.ranked) > 0 do %>
      <.card class="overflow-hidden">
        <.simple_table>
          <.simple_table_head>
            <.simple_table_header_cell>Rank</.simple_table_header_cell>
            <.simple_table_header_cell>Country</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Players</.simple_table_header_cell>
            <.simple_table_header_cell align="right">
              <div class="flex items-center justify-end gap-1">
                Prowess Score
                <span class="text-stone-400 dark:text-zinc-500 cursor-help group relative" title="Calculation">
                  <span class="invisible group-hover:visible absolute right-6 top-0 w-96 bg-gray-900 text-white text-sm rounded p-4 z-10 whitespace-pre-line leading-relaxed font-mono">Score = Σ(1/rank) / population

For each player:
  Rank #1    → 1.000
  Rank #10   → 0.100
  Rank #100  → 0.010
  Rank #1000 → 0.001

Sum all contributions, divide by
population (in millions)

∴ Rewards both quality (better
ranks contribute more) and
quantity (more players help)</span>
                  <.icon name="hero-information-circle" class="h-4 w-4" />
                </span>
              </div>
            </.simple_table_header_cell>
            <.simple_table_header_cell align="right">Avg Rank</.simple_table_header_cell>
            <.simple_table_header_cell align="right">Best Rank</.simple_table_header_cell>
          </.simple_table_head>
          <.simple_table_body>
            <%= for {item, index} <- Enum.with_index(@prowess_data.ranked, 1) do %>
              <.simple_table_row>
                <.simple_table_cell class="font-medium">#<%= index %></.simple_table_cell>
                <.simple_table_cell>
                  <div class="flex flex-row items-center">
                    <span class="mr-2 text-2xl"><%= WololoWeb.PlayerLive.get_country_code_emoji(item.country) %></span>
                    <%= get_country_name(item.country) %>
                  </div>
                </.simple_table_cell>
                <.simple_table_cell align="right"><%= format_number(item.player_count) %></.simple_table_cell>
                <.simple_table_cell align="right" class="font-semibold #{text_heading()}">
                  <%= item.prowess_score %>
                </.simple_table_cell>
                <.simple_table_cell align="right" class={text_muted()}>
                  #<%= format_number(trunc(item.avg_rank)) %>
                </.simple_table_cell>
                <.simple_table_cell align="right" class={text_muted()}>
                  #<%= format_number(item.best_rank) %>
                </.simple_table_cell>
              </.simple_table_row>
            <% end %>
          </.simple_table_body>
        </.simple_table>
      </.card>
    <% end %>
   
  <% end %>
</div>

