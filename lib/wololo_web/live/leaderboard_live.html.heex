<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-stone-800 dark:text-zinc-100 mb-2">
      Conqueror Players by Country
    </h1>
    <p class="text-lg text-gray-600 dark:text-stone-400">
      Country distribution of all players with rating above 1400
    </p>
  </div>

  <%= if @loading do %>
    <div class="flex flex-col items-center justify-center py-12">
      <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-stone-800 dark:border-zinc-100">
      </div>
      <p class="mt-4 text-gray-600 dark:text-stone-400">Loading leaderboard data...</p>
    </div>
  <% end %>

  <%= if @error do %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-red-800 dark:text-red-200 mb-2">
        Error Loading Data
      </h2>
      <p class="text-red-600 dark:text-red-300"><%= @error %></p>
    </div>
  <% end %>

  <%= if !@loading && !@error do %>
    <%
      current_data = case @active_tab do
        "conqueror" -> @conqueror_data
        "conqueror3" -> @conqueror3_data
        "top100" -> @top100_data
        _ -> @conqueror_data
      end
    %>
    
    <!-- Stats Card -->
    <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-stone-800 dark:text-zinc-100 mb-4">
        Statistics
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <p class="text-sm text-gray-600 dark:text-stone-400">Total Players</p>
          <p class="text-3xl font-bold text-stone-800 dark:text-zinc-100">
            <%= format_number(current_data.total) %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-600 dark:text-stone-400">Countries Represented</p>
          <p class="text-3xl font-bold text-stone-800 dark:text-zinc-100">
            <%= map_size(current_data.distribution) %>
          </p>
        </div>
        <%= if @last_updated do %>
          <div>
            <p class="text-sm text-gray-600 dark:text-stone-400">Last Updated</p>
            <p class="text-sm text-stone-800 dark:text-zinc-100">
              <%= format_timestamp(@last_updated) %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mb-6 border-b border-gray-200 dark:border-zinc-700">
      <nav class="flex space-x-8" aria-label="Tabs">
        <button
          phx-click="switch_tab"
          phx-value-tab="conqueror"
          class={"#{if @active_tab == "conqueror", do: "border-blue-500 text-blue-600 dark:text-blue-400", else: "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"}
        >
          Conqueror (1400+)
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="conqueror3"
          class={"#{if @active_tab == "conqueror3", do: "border-blue-500 text-blue-600 dark:text-blue-400", else: "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"}
        >
          Conqueror III (2000+)
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="top100"
          class={"#{if @active_tab == "top100", do: "border-blue-500 text-blue-600 dark:text-blue-400", else: "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"}
        >
          Top 100
        </button>
      </nav>
    </div>

    <!-- Chart Card -->
    <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-lg p-6 mb-8">
      <div class="relative" style="height: 700px;">
        <canvas
          id="leaderboard-countries-chart"
          phx-hook="LeaderboardCountries"
          phx-update="ignore"
        >
        </canvas>
      </div>
    </div>

   
  <% end %>
</div>

