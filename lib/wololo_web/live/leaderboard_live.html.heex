<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-stone-800 dark:text-zinc-100 mb-2">
      Conqueror Players by Country
    </h1>
    <p class="text-lg text-gray-600 dark:text-stone-400">
      Country distribution of all players with rating above 1400
    </p>
  </div>

  <%= if @loading do %>
    <div class="flex flex-col items-center justify-center py-20">
      <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-stone-800 dark:border-zinc-100">
      </div>
      <p class="mt-4 text-gray-600 dark:text-stone-400">Loading leaderboard data...</p>
    </div>
  <% end %>

  <%= if @error do %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-red-800 dark:text-red-200 mb-2">
        Error Loading Data
      </h2>
      <p class="text-red-600 dark:text-red-300"><%= @error %></p>
    </div>
  <% end %>

  <%= if !@loading && !@error do %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Stats Card -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold text-stone-800 dark:text-zinc-100 mb-4">
          Statistics
        </h2>
        <div class="space-y-4">
          <div>
            <p class="text-sm text-gray-600 dark:text-stone-400">Total Conqueror Players</p>
            <p class="text-3xl font-bold text-stone-800 dark:text-zinc-100">
              <%= format_number(@total_conquerors) %>
            </p>
          </div>
          <div>
            <p class="text-sm text-gray-600 dark:text-stone-400">Countries Represented</p>
            <p class="text-3xl font-bold text-stone-800 dark:text-zinc-100">
              <%= map_size(@country_distribution) %>
            </p>
          </div>
          <%= if @last_updated do %>
            <div class="pt-4 border-t border-gray-200 dark:border-zinc-700">
              <p class="text-sm text-gray-600 dark:text-stone-400">Last Updated</p>
              <p class="text-sm text-stone-800 dark:text-zinc-100">
                <%= format_timestamp(@last_updated) %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
      <!-- Chart Card -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-lg p-6">
        <h2 class="text-2xl font-bold text-stone-800 dark:text-zinc-100 mb-4">
          Country Distribution
        </h2>
        <div class="relative" style="height: 400px;">
          <canvas
            id="leaderboard-countries-chart"
            phx-hook="LeaderboardCountries"
            phx-update="ignore"
          >
          </canvas>
        </div>
      </div>
    </div>

    <!-- Top Countries Table -->
    <div class="mt-8 bg-white dark:bg-zinc-800 rounded-lg shadow-lg p-6">
      <h2 class="text-2xl font-bold text-stone-800 dark:text-zinc-100 mb-4">
        Top Countries
      </h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-zinc-700">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-stone-400 uppercase tracking-wider">
                Rank
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-stone-400 uppercase tracking-wider">
                Country
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-stone-400 uppercase tracking-wider">
                Players
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-stone-400 uppercase tracking-wider">
                Percentage
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-zinc-700">
            <%= for {{country, percentage}, index} <- @country_distribution
                |> Enum.sort_by(fn {_country, pct} -> pct end, :desc)
                |> Enum.take(10)
                |> Enum.with_index(1) do %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-800 dark:text-zinc-100">
                  #<%= index %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-stone-800 dark:text-zinc-100">
                  <%= String.upcase(country) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-800 dark:text-zinc-100">
                  <%= format_number(round(@total_conquerors * percentage / 100)) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-800 dark:text-zinc-100">
                  <%= Float.round(percentage, 1) %>%
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

