<div id="insights" class="px-12">
  <.async_result :let={insights} assign={@insights}>
    <:loading>
      <div class="flex flex-col justify-center items-center space-y-8 min-h-[400px]">
        <.spinner size="lg" class="text-primary-500" />

        <div class="text-center space-y-3">
          <p class="text-xl font-medium text-stone-700 dark:text-zinc-300">
            Please be patient, querying LLM<span class="inline-flex w-12 ml-1">
              <span class="ml-3 text-3xl leading-none animate-[bounce_1.4s_ease-in-out_infinite]">.</span>
              <span class="text-3xl leading-none animate-[bounce_1.4s_ease-in-out_0.2s_infinite]">.</span>
              <span class="text-3xl leading-none animate-[bounce_1.4s_ease-in-out_0.4s_infinite]">.</span>
            </span>
          </p>
        </div>
      </div>
    </:loading>
    <:failed :let={reason}>
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-amber-800 dark:text-amber-200">
              Unable to load insights
            </h3>
            <div class="mt-2 text-sm text-amber-700 dark:text-amber-300">
              <%= reason %>
            </div>
          </div>
        </div>
      </div>
    </:failed>

    <h1 class="font-zabal text-4xl my-8 text-center text-stone-800 dark:text-zinc-100">
      Insights
    </h1>

    <%= Phoenix.HTML.raw(insights) %>
  </.async_result>
</div>
