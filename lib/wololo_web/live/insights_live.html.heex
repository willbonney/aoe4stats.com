<div id="insights" class="px-12">
  <.async_result :let={insights} assign={@insights}>
    <:loading>
      <div class="flex flex-col justify-center items-center space-y-8 min-h-[400px]">
        <.spinner size="lg" class="text-brand-500" />
        
        <div class="text-center space-y-3">
          <p class="text-xl font-medium text-stone-700 dark:text-zinc-300">
            Please be patient, querying LLM<span class="inline-flex w-12 ml-1">
              <span class="ml-3 text-3xl leading-none animate-[bounce_1.4s_ease-in-out_infinite]">.</span>
              <span class="text-3xl leading-none animate-[bounce_1.4s_ease-in-out_0.2s_infinite]">.</span>
              <span class="text-3xl leading-none animate-[bounce_1.4s_ease-in-out_0.4s_infinite]">.</span>
            </span>
          </p>
        </div>
      </div>
    </:loading>
    <:failed :let={_reason}>
      <div class="text-center text-red-500 dark:text-red-400 py-8">
        Failed to load insights. Please try again later.
      </div>
    </:failed>
    
    <h1 class="font-zabal text-4xl my-8 text-center text-stone-800 dark:text-zinc-100">
      Insights
    </h1>
    
    <%= Phoenix.HTML.raw(insights) %>
  </.async_result>
</div>
