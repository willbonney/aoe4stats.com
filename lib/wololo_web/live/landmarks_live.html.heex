<div class="mx-auto max-w-5xl">
  <.header>Landmark Path</.header>
  <p class="mb-4 text-sm text-stone-600 dark:text-zinc-400">
    Pick a civ, the map you're on, and optionally the opponent. We'll recommend the landmark
    path through Age II, III, or IV with the highest ranked 1v1 win rate.
  </p>

  <%= if is_nil(@selected_civ) do %>
    <div class="mt-8 mb-10 flex items-center justify-center gap-3 sm:gap-5">
      <%= for {n, label, current?} <- [
            {1, "Civ", true},
            {2, "Map", false},
            {3, "Opponent", false}
          ] do %>
        <div class="flex items-center gap-2 sm:gap-3">
          <span
            class={[
              "flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full text-base sm:text-lg font-bold",
              !current? && "border-2 border-stone-300 text-stone-500 dark:border-zinc-600 dark:text-zinc-500"
            ]}
            style={if current?, do: "background-color:#c93d15;color:#ffffff"}
          >
            <%= n %>
          </span>
          <span class={[
            "text-base sm:text-xl font-semibold",
            current? && "text-stone-800 dark:text-zinc-100",
            !current? && "text-stone-400 dark:text-zinc-500"
          ]}>
            <%= label %>
          </span>
        </div>
        <%= if n < 3 do %>
          <.icon name="hero-arrow-right" class="h-6 w-6 sm:h-7 sm:w-7 text-stone-300 dark:text-zinc-600 shrink-0" />
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= if @selected_civ do %>
    <% pills_locked? = @loading or @loading_matchups %>
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center text-base sm:text-lg">
      <div class="flex flex-wrap items-center gap-3 min-w-0 sm:flex-1" phx-click-away="close-menu">
        <div class="relative">
          <button type="button" phx-click="toggle-menu" phx-value-menu="civ" disabled={pills_locked?} class="landmark-pill inline-flex items-center rounded-full border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-5 pr-5 py-2.5">
            <img src={"/images/#{@selected_civ.image}.png"} alt="" class="h-5 w-8 shrink-0 rounded-sm object-cover" />
            <span class="font-semibold text-stone-800 dark:text-zinc-100"><%= @selected_civ.label %></span>
            <svg class="h-4 w-4 shrink-0 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <%= if @open_menu == :civ and not pills_locked? do %>
            <div class="absolute left-0 top-full z-40 mt-2 max-h-80 w-56 overflow-y-auto rounded-xl border border-stone-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-900">
              <%= for civ <- @civs do %>
                <button type="button" phx-click="change-civ" phx-value-civ={civ.slug} class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-100 dark:text-zinc-100 dark:hover:bg-zinc-800">
                  <img src={"/images/#{civ.image}.png"} alt="" class="h-4 w-7 rounded-sm object-cover" />
                  <span class={@selected_civ.slug == civ.slug && "font-semibold"}><%= civ.label %></span>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <%= if @selected_map do %>
          <span class="text-stone-400 dark:text-zinc-500">on</span>
          <div class="relative">
            <button type="button" phx-click="toggle-menu" phx-value-menu="map" disabled={pills_locked?} class="landmark-pill inline-flex items-center rounded-full border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-5 pr-5 py-2.5 text-stone-800 dark:text-zinc-100">
              <%= if map_icon(@selected_map) do %>
                <span class="h-6 w-6 shrink-0 overflow-hidden rounded-sm">
                  <img src={map_icon(@selected_map)} alt="" class="h-full w-full object-cover" />
                </span>
              <% else %>
                <.icon name="hero-map" class="h-6 w-6 text-stone-500" />
              <% end %>
              <span class="font-semibold"><%= if @selected_map.any?, do: "any map", else: @selected_map.name %></span>
              <svg class="h-4 w-4 shrink-0 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <%= if @open_menu == :map and not pills_locked? do %>
              <div class="absolute left-0 top-full z-40 mt-2 max-h-80 w-56 overflow-y-auto rounded-xl border border-stone-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-900">
                <%= for map <- @maps do %>
                  <button type="button" phx-click="change-map" phx-value-map={map.name || ""} class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-100 dark:text-zinc-100 dark:hover:bg-zinc-800">
                    <%= if map_icon(map) do %>
                      <img src={map_icon(map)} alt="" class="h-5 w-5 rounded-sm object-cover" />
                    <% else %>
                      <.icon name="hero-map" class="h-5 w-5 text-stone-400" />
                    <% end %>
                    <span class={@selected_map && ((map.any? && @selected_map.any?) || map.name == @selected_map.name) && "font-semibold"}>
                      <%= if map.any?, do: "any map", else: map.name %>
                    </span>
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= if @selected_map && (@selected_opponent || @step == :result) do %>
          <span class="text-stone-400 dark:text-zinc-500">vs</span>
          <div class="relative">
            <button type="button" phx-click="toggle-menu" phx-value-menu="opponent" disabled={pills_locked?} class={[
              "landmark-pill inline-flex items-center rounded-full border bg-white dark:bg-zinc-900 pl-5 pr-5 py-2.5",
              @selected_opponent && "border-stone-300 dark:border-zinc-700",
              !@selected_opponent && "border-dashed border-stone-300 dark:border-zinc-600 text-stone-500 dark:text-zinc-400"
            ]}>
              <%= if @selected_opponent do %>
                <img src={"/images/#{@selected_opponent.image}.png"} alt="" class="h-5 w-8 shrink-0 rounded-sm object-cover" />
                <span class="font-semibold text-stone-800 dark:text-zinc-100"><%= @selected_opponent.label %></span>
              <% else %>
                <span class="font-semibold">Any Civ</span>
              <% end %>
              <svg class="h-4 w-4 shrink-0 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <%= if @open_menu == :opponent and not pills_locked? do %>
              <div class="absolute left-0 top-full z-40 mt-2 max-h-80 w-56 overflow-y-auto rounded-xl border border-stone-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-900">
                <button type="button" phx-click="change-opponent" phx-value-civ="any" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-100 dark:text-zinc-100 dark:hover:bg-zinc-800">
                  <span class={is_nil(@selected_opponent) && "font-semibold"}>Any Civ</span>
                </button>
                <%= for civ <- @civs, is_nil(@selected_civ) or civ.slug != @selected_civ.slug do %>
                  <button type="button" phx-click="change-opponent" phx-value-civ={civ.slug} class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-100 dark:text-zinc-100 dark:hover:bg-zinc-800">
                    <img src={"/images/#{civ.image}.png"} alt="" class="h-4 w-7 rounded-sm object-cover" />
                    <span class={@selected_opponent && @selected_opponent.slug == civ.slug && "font-semibold"}><%= civ.label %></span>
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <span class="text-stone-400 dark:text-zinc-500">through</span>
        <% current_through = through_choice(@selected_through) %>
        <div class="relative">
          <button type="button" phx-click="toggle-menu" phx-value-menu="ages" disabled={pills_locked?} class="landmark-pill inline-flex items-center rounded-full border border-stone-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-5 pr-5 py-2.5 text-stone-800 dark:text-zinc-100">
            <span class="font-semibold"><%= current_through.label %></span>
            <svg class="h-4 w-4 shrink-0 text-stone-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <%= if @open_menu == :ages and not pills_locked? do %>
            <div class="absolute left-0 top-full z-40 mt-2 w-36 overflow-y-auto rounded-xl border border-stone-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-900">
              <%= for choice <- @through_choices do %>
                <button type="button" phx-click="change-ages" phx-value-ages={choice.slug} class="flex w-full items-center px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-100 dark:text-zinc-100 dark:hover:bg-zinc-800">
                  <span class={@selected_through == choice.value && "font-semibold"}><%= choice.label %></span>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <button type="button" phx-click="start-over" class="landmark-reset">
        Start over
      </button>
    </div>
  <% end %>

  <%= if @error do %>
    <.error><%= @error %></.error>
  <% end %>

  <%= if @step == :civ do %>
    <h2 class="mb-3 text-base font-semibold text-stone-800 dark:text-zinc-100">Which civ are you playing?</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      <%= for civ <- @civs do %>
        <button
          type="button"
          phx-click="select-civ"
          phx-value-civ={civ.slug}
          class={[
            "landmark-tile flex items-center gap-3 rounded-xl border-2 p-3 text-left",
            @selected_civ && @selected_civ.slug == civ.slug && "border-primary-500 bg-primary-50 dark:bg-primary-950/40",
            (!@selected_civ || @selected_civ.slug != civ.slug) && "border-stone-200 dark:border-zinc-700"
          ]}
        >
          <img src={"/images/#{civ.image}.png"} alt="" class="h-7 w-10 object-cover rounded-sm shrink-0" />
          <span class="text-sm font-medium text-stone-800 dark:text-zinc-100"><%= civ.label %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <%= if @step == :map do %>
    <h2 class="mb-1 text-base font-semibold text-stone-800 dark:text-zinc-100">Which map?</h2>
    <p class="mb-4 text-sm text-stone-500 dark:text-zinc-400">
      Paths are ranked 1v1 on the map you pick. Choose any map for the combined sample.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      <%= for map <- @maps do %>
        <% selected? = @selected_map && ((map.any? && @selected_map.any?) || (!map.any? && @selected_map.name == map.name)) %>
        <button
          type="button"
          id={if map.any?, do: "any-map"}
          phx-click="select-map"
          phx-value-map={map.name || ""}
          class={[
            "landmark-tile overflow-hidden rounded-xl border-2 text-left",
            selected? && "border-primary-500 ring-2 ring-primary-500/30",
            !selected? && "border-stone-200 dark:border-zinc-700"
          ]}
        >
          <div class="aspect-square overflow-hidden bg-stone-100 dark:bg-zinc-800">
            <%= if map_icon(map) do %>
              <img src={map_icon(map)} alt="" class="h-full w-full object-cover" />
            <% else %>
              <div class="flex h-full w-full items-center justify-center">
                <svg
                  class="h-14 w-14 text-stone-400"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z"
                  />
                </svg>
              </div>
            <% end %>
          </div>
          <div class="truncate px-2 py-2 text-center text-sm font-medium text-stone-800 dark:text-zinc-100">
            <%= if map.any?, do: "Any map", else: map.name %>
          </div>
        </button>
      <% end %>
    </div>
  <% end %>

  <%= if @step == :opponent do %>
    <div class="mb-4 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
      <div>
        <h2 class="text-base font-semibold text-stone-800 dark:text-zinc-100">Who are you facing?</h2>
        <p class="text-sm text-stone-500 dark:text-zinc-400">Optional. Skip this if you don't know the matchup yet.</p>
      </div>
      <button
        type="button"
        phx-click="skip-opponent"
        class="px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700"
      >
        Skip — Any Civ
      </button>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      <%= for civ <- @civs, is_nil(@selected_civ) or civ.slug != @selected_civ.slug do %>
        <button
          type="button"
          phx-click="select-opponent"
          phx-value-civ={civ.slug}
          class={[
            "landmark-tile flex items-center gap-3 rounded-xl border-2 p-3 text-left",
            @selected_opponent && @selected_opponent.slug == civ.slug && "border-primary-500 bg-primary-50 dark:bg-primary-950/40",
            (!@selected_opponent || @selected_opponent.slug != civ.slug) && "border-stone-200 dark:border-zinc-700"
          ]}
        >
          <img src={"/images/#{civ.image}.png"} alt="" class="h-7 w-10 object-cover rounded-sm shrink-0" />
          <span class="text-sm font-medium text-stone-800 dark:text-zinc-100"><%= civ.label %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <%= if @step == :result do %>
    <%= if @loading or @loading_matchups do %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <div class="flex items-center">
          <.spinner size="lg" class="text-primary-500" />
          <span class="ml-3 text-stone-600 dark:text-zinc-400">Finding the strongest path...</span>
        </div>
        <p class="mt-3 max-w-sm text-sm text-stone-500 dark:text-zinc-500">
          First load can take 30–60 seconds to complete.
        </p>
      </div>
    <% else %>
      <%= if @recommendation && @recommendation.path do %>
        <% path = @recommendation.path %>
        <% ages = path_landmarks(path) %>
        <% stats = result_stats(@selected_civ, @selected_map, @selected_opponent, @recommendation) %>
        <div class="rounded-2xl border border-stone-200 dark:border-zinc-700 bg-stone-50 dark:bg-zinc-900 p-5 sm:p-8">
          <div class="mb-5">
            <p class="text-sm uppercase tracking-wide text-stone-500 dark:text-zinc-400">Recommended path</p>
            <h2 class="text-xl sm:text-2xl font-semibold text-stone-800 dark:text-zinc-100">
              <%= @selected_civ.label %>
              <%= if @selected_opponent do %>
                <span class="text-stone-400 font-normal"> vs </span><%= @selected_opponent.label %>
              <% end %>
            </h2>
          </div>

          <%= if stats != [] do %>
            <div class="mb-6 grid grid-cols-1 overflow-hidden rounded-xl border border-stone-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 sm:grid-cols-2">
              <%= for {stat, idx} <- Enum.with_index(stats) do %>
                <div class={[
                  "px-4 py-4 text-center",
                  idx > 0 && "border-t border-stone-200 dark:border-zinc-700 sm:border-t-0 sm:border-l"
                ]}>
                  <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-zinc-400">
                    <%= stat.title %>
                  </p>
                  <p class={"text-2xl font-bold tabular-nums #{color_class(stat.wr, :text)}"}>
                    <%= format_win_rate(stat.wr) %>
                  </p>
                  <p class="mt-1 text-sm text-stone-500 dark:text-zinc-400">
                    <%= stat.detail %><%= if stat.games do %> · <%= format_number(stat.games) %> games<% end %>
                  </p>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="flex flex-col sm:flex-row sm:items-stretch">
            <%= for {{landmark, label}, idx} <- Enum.with_index(ages) do %>
              <div class="landmark-tile flex-1 rounded-xl bg-white dark:bg-zinc-800 border-2 border-primary-200 dark:border-primary-900/60 p-4 text-center shadow-sm">
                <p class="mb-3 text-xs uppercase tracking-wide text-stone-500 dark:text-zinc-400"><%= label %></p>
                <%= if landmark.icon do %>
                  <img src={landmark.icon} alt="" class="mx-auto h-16 w-16 object-contain mb-3" />
                <% else %>
                  <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-lg bg-stone-100 dark:bg-zinc-700">
                    <.icon name="hero-flag" class="h-8 w-8 text-stone-400" />
                  </div>
                <% end %>
                <p class="font-semibold text-stone-800 dark:text-zinc-100 leading-snug"><%= landmark.name %></p>
                <%= if format_clock(landmark.finished_at) do %>
                  <p class="mt-1 text-xs text-stone-500 dark:text-zinc-400">typical ~<%= format_clock(landmark.finished_at) %></p>
                <% end %>
              </div>

              <%= if idx < length(ages) - 1 do %>
                <div class="flex items-center justify-center shrink-0 py-2 sm:py-0 sm:px-2 text-primary-500">
                  <svg class="hidden sm:block h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                  <svg class="sm:hidden h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                  </svg>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <%= if @recommendation.alternatives != [] do %>
          <h3 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-zinc-400">
            Other paths...
          </h3>
          <div class="space-y-2">
            <%= for alt <- @recommendation.alternatives do %>
              <div class="landmark-tile flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 rounded-xl border border-stone-200 dark:border-zinc-700 px-4 py-3">
                <div class="flex-1 text-sm text-stone-800 dark:text-zinc-100">
                  <span class="inline-flex flex-wrap items-center gap-x-1.5 gap-y-1">
                    <%= for {{landmark, _label}, idx} <- Enum.with_index(path_landmarks(alt)) do %>
                      <%= if idx > 0 do %>
                        <.icon name="hero-arrow-right" class="h-4 w-4 shrink-0 text-primary-400" />
                      <% end %>
                      <%= landmark.name %>
                    <% end %>
                  </span>
                </div>
                <div class={"text-sm font-semibold #{color_class(alt.win_rate, :text)}"}>
                  <%= format_win_rate(alt.win_rate) %>
                  <span class="font-normal text-stone-400">(<%= format_number(alt.games) %>)</span>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-stone-600 dark:text-zinc-400">
          No complete <%= through_range_label(@selected_through) %> landmark paths found for this civ in the current sample.
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
