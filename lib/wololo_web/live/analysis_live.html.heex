<div id="analysis">
  <% common_stat_classes =
    "font-zabal font-black text-3xl mx-auto text-center text-stone-800 dark:text-zinc-100" %>
  <.async_result :let={analysis} assign={@analysis}>
    <:loading>
      <div class="flex justify-center items-center">
        <.spinner size="lg" class="text-brand-500" />
      </div>
    </:loading>
    <:failed :let={_reason}>Failed to load analysis</:failed>

    <h1 class="font-zabal font-gray text-4xl my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
      Analysis
    </h1>
    
    <!-- Metric Descriptions -->
    <div class="max-w-4xl mx-auto mb-8 space-y-2" id="metric-descriptions">
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Consistency">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Consistency:</span>
        <span class="text-stone-600 dark:text-zinc-300"> How stable your performance is across games. Higher scores mean fewer rating swings.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Recovery">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Recovery:</span>
        <span class="text-stone-600 dark:text-zinc-300"> How quickly you bounce back from losing streaks. Higher scores mean faster recovery.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Momentum">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Momentum:</span>
        <span class="text-stone-600 dark:text-zinc-300"> Your ability to maintain winning streaks. Higher scores indicate longer win streaks.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Anti-Tilt">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Anti-Tilt:</span>
        <span class="text-stone-600 dark:text-zinc-300"> Mental resilience after losses. Higher scores show you don't chain losses together.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Pressure">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Pressure:</span>
        <span class="text-stone-600 dark:text-zinc-300"> Performance near rank thresholds. Higher scores mean you clutch up when it matters.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Efficiency">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Efficiency:</span>
        <span class="text-stone-600 dark:text-zinc-300"> How much rating you gain per game played. Higher scores mean faster climbing.</span>
      </div>
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-3 cursor-pointer hover:shadow-lg transition-shadow" data-metric="Versatility">
        <span class="font-semibold text-stone-800 dark:text-zinc-100">Versatility:</span>
        <span class="text-stone-600 dark:text-zinc-300"> Success across multiple civilizations. Higher scores mean you excel with more civs.</span>
      </div>
    </div>

    <canvas id="analysis-chart" phx-hook="Analysis" data-points={}></canvas>
  </.async_result>
</div>
