<div id="analysis">
  <% common_stat_classes =
    "font-zabal font-black text-4xl mx-auto text-center text-stone-800 dark:text-zinc-100" %>
  
  <% metrics = [
    %{name: "Consistency", key: :consistency, icon: "hero-chart-bar", color_class: "text-blue-500", description: "How stable your performance is across games. Higher scores mean fewer rating swings.", calculation: "1. Sort rating history by timestamp\n2. Extract all rating values\n3. Calculate differences between consecutive ratings\n4. Calculate average rating change\n5. Calculate standard deviation of changes\n6. Invert score: 100 - std_dev (capped at 100)\nResult: Lower volatility = higher consistency score"},
    %{name: "Recovery", key: :recovery, icon: "hero-arrow-trending-up", color_class: "text-green-500", description: "How quickly you bounce back from losing streaks. Higher scores mean faster recovery.", calculation: "1. Sort rating history by timestamp\n2. Track each losing streak (negative streak values)\n3. Record streak length when it breaks (becomes positive)\n4. Calculate average losing streak length\n5. Normalize: 100 - (avg_streak * 10)\nResult: Shorter losing streaks = higher recovery score"},
    %{name: "Momentum", key: :momentum, icon: "hero-rocket-launch", color_class: "text-purple-500", description: "Your ability to maintain winning streaks. Higher scores indicate longer win streaks.", calculation: "1. Sort rating history by timestamp\n2. Extract all streak values\n3. Filter to positive streaks only (wins)\n4. Calculate average winning streak length\n5. Normalize: avg_streak * 20 (capped at 100)\nResult: Longer winning streaks = higher momentum score"},
    %{name: "Anti-Tilt", key: :anti_tilt, icon: "hero-shield-check", color_class: "text-cyan-500", description: "Mental resilience after losses. Higher scores show you tilt less often.", calculation: "1. Sort rating history by timestamp\n2. Look at consecutive game pairs\n3. Count: wins after wins, losses after wins, etc.\n4. Calculate win_after_win rate\n5. Calculate loss_after_loss rate\n6. Score = (win_after_win + (1 - loss_after_loss)) / 2\nResult: High wins after wins + low losses after losses = high score"},
    %{name: "Pressure", key: :pressure_performance, icon: "hero-fire", color_class: "text-orange-500", description: "Win rate when near rank thresholds (±25 rating). Higher scores mean you perform better when your rank is on the line.", calculation: "1. Get rank thresholds (700, 800, 900, 1000, etc.)\n2. Sort rating history by timestamp\n3. For each game, check if within ±25 of any threshold\n4. Count wins and total games in pressure situations\n5. Calculate win rate: pressure_wins / pressure_total\n6. Convert to 0-100 scale\nResult: Higher win rate near thresholds = higher clutch score"},
    %{name: "Efficiency", key: :rating_efficiency, icon: "hero-bolt", color_class: "text-yellow-500", description: "How much rating you gain per game played. Higher scores mean faster climbing.", calculation: "1. Sort rating history by timestamp\n2. Get first rating and last rating\n3. Calculate rating change: last - first\n4. Calculate rating per game: change / games_played\n5. Normalize: (rating_per_game + 5) * 10\n6. Cap between 0 and 100\nResult: More rating gained per game = higher efficiency score"},
    %{name: "Versatility", key: :versatility, icon: "hero-sparkles", color_class: "text-pink-500", description: "Success across multiple civilizations. Higher scores mean you excel with more civs.", calculation: "1. Calculate total games across all civs\n2. Set min games threshold: max(5, total * 0.05)\n3. Filter to civs with games >= threshold\n4. Filter to civs with >=50% win rate\n5. If <=1 good civ: return 0\n6. Calculate avg WR of good civs\n7. Diversity = 100 * (1 - 1/good_civs) * 1.15\n8. WR multiplier = (avg_wr / 50) ^ 1.8\n9. Final = min(100, diversity * multiplier)\nResult: 1 civ = 0, 2 civs @55% = 68, 3 civs @53% = 81"}
  ] %>
  
  <.async_result :let={analysis} assign={@analysis}>
    <:loading>
      <div class="flex justify-center items-center">
        <.spinner size="lg" class="text-brand-500" />
      </div>
    </:loading>
    <:failed :let={_reason}>Failed to load analysis</:failed>

    <h1 class={common_stat_classes <> " text-4xl my-8"}>
      Analysis
    </h1>
    
    <!-- Metric Descriptions -->
    <div class="max-w-6xl mx-auto mb-8 grid grid-cols-1 md:grid-cols-2 gap-4" id="metric-descriptions">
      <%= for metric <- metrics do %>
        <div class="bg-white dark:bg-zinc-800 rounded-lg shadow p-4 cursor-pointer hover:shadow-lg transition-shadow" data-metric={metric.name}>
          <div class="flex items-center gap-2 mb-2">
            <.icon name={metric.icon} class={"h-6 w-6 #{metric.color_class} flex-shrink-0"} />
            <span class={common_stat_classes <> " !mx-0 text-xl font-medium"}><%= metric.name %>:</span>
            <%= if is_nil(Map.get(analysis, metric.key)) do %>
              <span class="text-sm text-stone-500 dark:text-zinc-400 italic">(insufficient data)</span>
            <% else %>
              <span class={common_stat_classes <> " !mx-0 text-xl font-bold"}><%= Float.round(Map.get(analysis, metric.key), 1) %></span>
            <% end %>
            <span class="text-stone-400 dark:text-zinc-500 cursor-help group relative ml-auto" title="Calculation">
              <span class="invisible group-hover:visible absolute right-6 top-0 w-80 bg-gray-900 text-white text-xs rounded p-3 z-10 whitespace-pre-line leading-relaxed"><%= metric.calculation %></span>
              <.icon name="hero-information-circle" class="h-4 w-4" />
            </span>
          </div>
          <p class="text-sm text-stone-600 dark:text-zinc-300"><%= metric.description %></p>
        </div>
      <% end %>
    </div>

    <canvas id="analysis-chart" phx-hook="Analysis" data-points={}></canvas>
  </.async_result>
</div>
