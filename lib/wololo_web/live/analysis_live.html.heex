<div id="analysis">
  <% common_stat_classes =
    "font-zabal font-black text-3xl mx-auto text-center text-stone-800 dark:text-zinc-100" %>
  <.async_result :let={analysis} assign={@analysis}>
    <:loading>
      <div class="flex justify-center items-center">
        <.spinner size="lg" class="text-brand-500" />
      </div>
    </:loading>
    <:failed :let={_reason}>Failed to load analysis</:failed>

    <h1 class="font-zabal font-gray text-4xl my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
      Analysis
    </h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto p-4">
      <!-- Consistency Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Consistency
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.consistency, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Performance Stability
        </p>
      </div>

      <!-- Recovery Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Recovery
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.recovery, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Bounce Back Speed
        </p>
      </div>

      <!-- Momentum Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Momentum
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.momentum, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Win Streak Ability
        </p>
      </div>

      <!-- Anti-Tilt Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Anti-Tilt
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.anti_tilt, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Mental Resilience
        </p>
      </div>

      <!-- Pressure Performance Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Clutch Factor
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.pressure_performance, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Performance Under Pressure
        </p>
      </div>

      <!-- Rating Efficiency Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Efficiency
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.rating_efficiency, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Rating Climb Speed
        </p>
      </div>

      <!-- Versatility Score -->
      <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-6 text-center">
        <h3 class="text-lg font-semibold text-stone-700 dark:text-zinc-200 mb-2">
          Versatility
        </h3>
        <p class={common_stat_classes}>
          <%= Float.round(analysis.versatility, 1) %>
        </p>
        <p class="text-sm text-stone-500 dark:text-zinc-400 mt-2">
          Civ Diversity
        </p>
      </div>
    </div>

  </.async_result>
</div>
