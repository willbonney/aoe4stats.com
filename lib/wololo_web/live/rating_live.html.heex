<div id="rating">
  <% common_stat_classes =
    "font-zabal font-black text-3xl mx-auto text-center text-stone-800 dark:text-zinc-100" %>
  <.async_result :let={stats} assign={@stats}>
    <:loading>
      <div class="flex justify-center items-center">
        <.spinner size="lg" class="text-primary-500" />
      </div>
    </:loading>
    <:failed :let={reason}>
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-amber-800 dark:text-amber-200">
              Unable to load rating data
            </h3>
            <div class="mt-2 text-sm text-amber-700 dark:text-amber-300">
              <%= format_error(reason) %>
            </div>
          </div>
        </div>
      </div>
    </:failed>
    <%!-- stupid tw --%>
    <div class="text-[#B87333]" />
    <div class="text-[#C0C0C0]" />
    <div class="text-[#FFC125]" />
    <div class="text-[#E6E6E6]" />
    <div class="text-[#87CEEB]" />
    <div class="text-[#FF8C00]" />
    <div class="text-[#DDDDDD]" />
    <%!-- stupid tw --%>

    <h1 class="font-zabal font-gray text-4xl my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
      Current Season Rating
    </h1>
    <h1 class={[common_stat_classes]}>
      Max:
      <span class={["text-[#{rating_to_color_map(stats[:max_rating])}]"]}>
        <%= stats[:max_rating] %>
      </span>
    </h1>
    <h1 class={[common_stat_classes]}>
      7D High:
      <span class={["text-[#{rating_to_color_map(stats[:max_rating_7d])}]"]}>
        <%= stats[:max_rating_7d] %>
      </span>
    </h1>
    <h1 class={[common_stat_classes]}>
      30D High:
      <span class={["text-[#{rating_to_color_map(stats[:max_rating_1m])}]"]}>
        <%= stats[:max_rating_1m] %>
      </span>
    </h1>
    <%!-- line break --%>
    <h1 class={[common_stat_classes]}>
      Last <%= stats[:total_count] %> games:
      <span class={["text-[#{rating_to_color_map(stats[:average_rating])}]"]}>
        <%= stats[:average_rating] %>
      </span>
    </h1>
    <h1 class={[common_stat_classes, "flex items-center justify-center gap-2"]}>
      <span>Standard Deviation:</span>
      <span style="color: rgba(230, 74, 25, 1);">
        ±<%= stats[:rating_spread] %>
      </span>
      <span class="text-stone-400 dark:text-zinc-500 cursor-help group relative">
              <.icon name="hero-information-circle" class="h-4 w-4" />
              <span class="invisible group-hover:visible absolute right-6 top-0 w-96 bg-gray-900 text-white text-sm rounded p-4 z-10 whitespace-pre-line leading-relaxed font-mono">Standard deviation of all your ratings. High = "feast or famine" player with large swings. Low = stable rating band.</span>
            </span>
    </h1>
    <div class="border-b border-gray-200 mt-8"></div>
    <div class="flex flex-col items-center gap-4 my-8">
      <h1 class="font-zabal font-gray text-4xl text-center text-stone-800 dark:text-zinc-100">
        Moving Averages
      </h1>
      <label class="inline-flex items-center gap-3 cursor-pointer select-none">
        <span class="text-sm text-stone-600 dark:text-zinc-400">Show League Bands</span>
        <button
          type="button"
          phx-click="toggle-league-bands"
          phx-target={@myself}
          class={"relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 " <> if @show_league_bands, do: "bg-primary-500", else: "bg-stone-300 dark:bg-zinc-600"}
          role="switch"
          aria-checked={@show_league_bands}
        >
          <span
            aria-hidden="true"
            class={"pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out " <> if @show_league_bands, do: "translate-x-5", else: "translate-x-0"}
          />
        </button>
      </label>
    </div>
    <canvas
      id="moving-averages"
      phx-hook="MovingAverages"
      phx-update="ignore"
      data-points={Jason.encode!(stats[:moving_averages])}
    >
    </canvas>

    <div class="border-b border-gray-200 mt-8"></div>

    <h1 class="font-zabal font-gray text-4xl my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
    Percent of Games Spent in Each Bracket
    </h1>

    <%= if is_nil(stats[:percentage_time_in_rank]) || map_size(stats[:percentage_time_in_rank]) == 0 do %>
      <div class="text-center py-8">
        <span class="text-sm text-stone-500 dark:text-zinc-400 italic">(insufficient data)</span>
      </div>
    <% else %>
    <h4 class="font-zabal font-gray text-xl my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
      (Current Season)
    </h4>
      <div class="mx-auto my-auto w-full max-w-[600px] center">
        <canvas
          id="percentage-time-in-rank"
          phx-hook="PercentageTimeInRank"
          phx-update="ignore"
          data-points={Jason.encode!(stats[:percentage_time_in_rank])}
        >
        </canvas>
      </div>
    <% end %>
  </.async_result>
</div>
