<div id="filter-persistence" phx-hook="FilterPersistence" class="hidden"></div>

<.header>Civs by Map</.header>

<div class="mb-4 space-y-4">
  <.form for={%{}} phx-change="select-league">
    <.input
      type="select"
      options={@league_options}
      name="league"
      prompt="Select a League"
      value={@selected_league}
      disabled={@loading}
    />
  </.form>

  <%= if @loading do %>
    <div class="flex justify-center items-center py-4">
      <.spinner size="lg" class="text-primary-500" />
      <span class="ml-3 text-stone-600 dark:text-zinc-400">Loading data...</span>
    </div>
  <% end %>

  <%= if not @loading do %>
    <div class="flex gap-4 flex-wrap items-center">
      <button
        phx-click="toggle-civ-filter"
        disabled={@loading}
        class={if MapSet.size(@selected_civs) < length(@civs) - 1, do: "filter-chip-active", else: "filter-chip"}
      >
        <.icon name="hero-funnel" class="h-5 w-5" />
        Civilizations (<%= MapSet.size(@selected_civs) %>/<%= length(@civs) - 1 %>)
      </button>

      <button
        phx-click="toggle-map-filter"
        disabled={@loading}
        class={
          if is_nil(@selected_maps) or MapSet.size(@selected_maps) < length(@maps),
            do: "filter-chip-active",
            else: "filter-chip"
        }
      >
        <.icon name="hero-funnel" class="h-5 w-5" />
        Maps (<%= if @selected_maps, do: MapSet.size(@selected_maps), else: 0 %>/<%= length(@maps) %>)
      </button>

      <%= if MapSet.size(@selected_civs) < length(@civs) - 1 or is_nil(@selected_maps) or MapSet.size(@selected_maps) < length(@maps) or @selected_league do %>
        <button
          phx-click="reset-all-filters"
          disabled={@loading}
          class="px-4 py-2 bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white rounded transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Reset All Filters
        </button>
      <% end %>
    </div>
  <% end %>

  <%= if @show_civ_filter and not @loading do %>
      <div class="border border-stone-300 dark:border-zinc-700 rounded-lg p-4 bg-stone-50 dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
            Select Civilizations (<%= MapSet.size(@selected_civs) %>/<%= length(@civs) - 1 %>)
          </h3>
          <div class="flex gap-2">
            <button
              phx-click="select-all-civs"
              disabled={@loading}
              class="text-sm px-3 py-1 bg-green-500 text-white rounded hover:bg-green-600 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Select All
            </button>
            <button
              phx-click="deselect-all-civs"
              disabled={@loading}
              class="text-sm px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Clear All
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          <%= for civ <- Enum.drop(@civs, 1) do %>
            <label class={"flex items-center gap-2 p-2 rounded " <> if @loading, do: "cursor-not-allowed opacity-50", else: "cursor-pointer hover:bg-stone-100 dark:hover:bg-zinc-800"}>
              <input
                type="checkbox"
                phx-click="toggle-civ"
                phx-value-civ={civ.key}
                checked={MapSet.member?(@selected_civs, civ.key)}
                disabled={@loading}
                class="w-4 h-4 text-primary-500 focus:ring-primary-500 disabled:cursor-not-allowed"
              />
              <%= if civ.image do %>
                <img src={"/images/#{civ.image}.png"} alt={civ.label} class="w-8 h-5" />
              <% end %>
              <span class="text-sm text-stone-800 dark:text-zinc-100"><%= civ.label %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

  <%= if @show_map_filter and not @loading do %>
      <div class="border border-stone-300 dark:border-zinc-700 rounded-lg p-4 bg-stone-50 dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
            Select Maps (<%= if @selected_maps, do: MapSet.size(@selected_maps), else: 0 %>/<%= length(@maps) %>)
          </h3>
          <div class="flex gap-2">
            <button
              phx-click="select-all-maps"
              disabled={@loading}
              class="text-sm px-3 py-1 bg-green-500 text-white rounded hover:bg-green-600 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Select All
            </button>
            <button
              phx-click="deselect-all-maps"
              disabled={@loading}
              class="text-sm px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Clear All
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <%= for map <- @maps do %>
            <label class={"flex items-center gap-2 p-2 rounded " <> if @loading, do: "cursor-not-allowed opacity-50", else: "cursor-pointer hover:bg-stone-100 dark:hover:bg-zinc-800"}>
              <input
                type="checkbox"
                phx-click="toggle-map"
                phx-value-map={map.name}
                checked={@selected_maps != nil and MapSet.member?(@selected_maps, map.name)}
                disabled={@loading}
                class="w-4 h-4 text-primary-500 focus:ring-primary-500 disabled:cursor-not-allowed"
              />
              <span class="text-sm text-stone-800 dark:text-zinc-100"><%= map.name %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
</div>

<%= if @error do %>
  <.error><%= @error %></.error>
<% else %>
  <%= if not @loading do %>
    <%
      filtered_civs_list = filtered_civs(@civs, @selected_civs)
      filtered_maps_list =
        @maps
        |> filtered_maps(@selected_maps)
        |> sorted_maps(@sort_by, @sort_dir, @selected_civs)
    %>

    <%= if MapSet.size(@selected_civs) == 0 or is_nil(@selected_maps) or MapSet.size(@selected_maps) == 0 do %>
      <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-6 text-center">
        <.icon name="hero-exclamation-triangle" class="h-12 w-12 mx-auto mb-4 text-yellow-600 dark:text-yellow-400" />
        <h3 class="text-lg font-semibold text-yellow-800 dark:text-yellow-200 mb-2">
          No Data to Display
        </h3>
        <p class="text-yellow-700 dark:text-yellow-300 mb-4">
          <%= cond do %>
            <% MapSet.size(@selected_civs) == 0 and (is_nil(@selected_maps) or MapSet.size(@selected_maps) == 0) -> %>
              Please select at least one civilization and one map to view data.
            <% MapSet.size(@selected_civs) == 0 -> %>
              Please select at least one civilization to view data.
            <% is_nil(@selected_maps) or MapSet.size(@selected_maps) == 0 -> %>
              Please select at least one map to view data.
          <% end %>
        </p>
        <button
          phx-click="reset-all-filters"
          class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 dark:bg-yellow-500 dark:hover:bg-yellow-600 text-white rounded transition-colors font-medium"
        >
          Reset Filters
        </button>
      </div>
    <% else %>

    <div class="hidden md:block">
      <.table id="aoe4_civilizations" rows={filtered_maps_list}>
        <:col :let={map} label={civ_header(%{image: nil, label: "Map"})}>
          <div class="p-2 w-full h-full text-stone-800 dark:text-zinc-100 flex items-center gap-1">
            <%= map.name %>
            <% best = best_civ_on_map(map, @selected_civs, @civs) %>
            <%= if best && best.image do %>
              <span class="inline-flex items-center text-stone-500 dark:text-zinc-400 font-normal" title={"Best: #{best.label}"}>
                <img src={"/images/#{best.image}.png"} alt={best.label} class="inline-block w-6 h-4 object-cover" />
              </span>
            <% end %>
          </div>
        </:col>
        <:col
          :let={map}
          :for={civ <- Enum.drop(filtered_civs_list, 1)}
          label={
            civ_header(%{
              image: civ.image,
              label: civ.label,
              column: civ.key,
              sortable: true,
              sort_by: @sort_by,
              sort_dir: @sort_dir
            })
          }
        >
          <div class={"#{color_class(get_in(map, [:civs, civ.key, :win_rate]), :bg)} p-2 w-full h-full hover:scale-[1.15] hover:brightness-95 transition-all duration-200 ease-in-out rounded-sm"}>
            <div class="flex flex-col items-center">
              <div>
                <%= get_in(map, [:civs, civ.key, :win_rate]) || "N/A" %>
              </div>
                             <div>
                 (<%= format_number(get_in(map, [:civs, civ.key, :games_count])) %>)
               </div>
            </div>
          </div>
        </:col>
        <:col
          :let={map}
          label={
            civ_header(%{
              image: nil,
              label: "Average",
              column: :average,
              sortable: true,
              sort_by: @sort_by,
              sort_dir: @sort_dir
            })
          }
        >
          <%
            civ_keys = Enum.drop(filtered_civs_list, 1) |> Enum.map(& &1.key)
            average = map_average_win_rate(map, civ_keys)
            average_win_rate = if average, do: "#{average}%", else: "N/A"

            total_games =
              Enum.drop(filtered_civs_list, 1)
              |> Enum.map(&get_in(map, [:civs, &1.key, :games_count]))
              |> Enum.reject(&is_nil/1)
              |> Enum.sum()
          %>
          <div class={"#{color_class(average_win_rate, :bg)} p-2 w-full h-full hover:scale-[1.15] hover:brightness-95 transition-all duration-200 ease-in-out rounded-sm"}>
            <div class="flex flex-col items-center justify-center h-full">
              <div>
                <%= average_win_rate %>
              </div>
                             <div>
                 (<%= format_number(total_games) %>)
               </div>
            </div>
          </div>
        </:col>
      </.table>
    </div>

    <div class="md:hidden space-y-4 w-full max-w-full">
      <%= for map <- filtered_maps_list do %>
        <div class="shadow rounded-lg overflow-hidden w-full">
          <div class="bg-zinc-100 dark:bg-stone-800 font-bold w-full flex items-center gap-1 px-3 py-2">
            <%= map.name %>
            <% best = best_civ_on_map(map, @selected_civs, @civs) %>
            <%= if best && best.image do %>
              <span class="inline-flex items-center font-normal text-stone-500 dark:text-zinc-400" title={"Best: #{best.label}"}>
                <img src={"/images/#{best.image}.png"} alt={best.label} class="inline-block w-6 h-4 object-cover" />
              </span>
            <% end %>
          </div>
          <div class="p-4">
            <div class="grid grid-cols-3 gap-2">
              <%= for civ <- Enum.drop(filtered_civs_list, 1) do %>
                <div class="flex flex-col items-center">
                  <%= if civ.image do %>
                    <img src={"/images/#{civ.image}.png"} alt={civ.label} class="w-10 h-6 mb-1" />
                  <% end %>
                  <span class={"text-sm font-semibold #{color_class(get_in(map, [:civs, civ.key, :win_rate]), :text)}"}>
                    <%= get_in(map, [:civs, civ.key, :win_rate]) || "N/A" %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%
      chart_map_name = resolved_chart_map(filtered_maps_list, @chart_map)
      favored_map = Enum.find(filtered_maps_list, &(&1.name == chart_map_name))
      favored_chart_rows = favored_rows(favored_map, @selected_civs, @civs)
      variance_chart_rows = variance_rows(filtered_maps_list, @selected_civs, @civs)
    %>

    <div
      id="civs-by-map-charts"
      class="mt-10 space-y-10"
      phx-hook="CivsByMapCharts"
      data-favored={Jason.encode!(favored_chart_rows)}
      data-variance={Jason.encode!(variance_chart_rows)}
    >
      <section>
        <div class="flex flex-col sm:flex-row sm:items-end gap-3">
          <form phx-change="select-chart-map" class="w-full sm:w-56">
            <label class="block text-sm font-semibold leading-6 text-zinc-800 dark:text-zinc-200">
              Map
            </label>
            <select
              name="map"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-white shadow-sm focus:border-zinc-400 focus:ring-0 sm:text-sm dark:bg-stone-800 dark:border-zinc-600 dark:text-zinc-100"
            >
              <%= for map <- filtered_maps_list do %>
                <option value={map.name} selected={map.name == chart_map_name}><%= map.name %></option>
              <% end %>
            </select>
          </form>
          <div>
            <h2 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
              Favored / unfavored
            </h2>
            <p class="text-sm text-stone-600 dark:text-zinc-400">
              Win rate vs 50% on the selected map. Right is favored, left is unfavored.
            </p>
          </div>
        </div>
        <div id="civs-by-map-favored-wrap" class="relative mt-4 w-full">
          <canvas id="civs-by-map-favored" data-chart="favored" phx-update="ignore"></canvas>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
          Map specialists vs generalists
        </h2>
        <p class="text-sm text-stone-600 dark:text-zinc-400">
          Each bar is that civ's win-rate range across the selected maps. Wider bars swing more by map; the tick is the average.
          <%= if length(filtered_maps_list) < 2 do %>
            Select more than one map to see a real range.
          <% end %>
        </p>
        <div id="civs-by-map-variance-wrap" class="relative mt-4 w-full">
          <canvas id="civs-by-map-variance" data-chart="variance" phx-update="ignore"></canvas>
        </div>
      </section>
    </div>
    <% end %>
  <% end %>
<% end %>
