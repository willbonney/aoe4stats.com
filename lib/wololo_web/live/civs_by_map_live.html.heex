<.header>Civs by Map</.header>

<%= if @loading do %>
  <div class="flex justify-center items-center">
    <.spinner size="lg" class="text-brand-500" />
  </div>
<% else %>
  <div class="mb-4 space-y-4">
    <.form for={%{}} phx-change="select-league">
      <.input
        type="select"
        options={@league_options}
        name="league"
        prompt="Select a League"
        value={@selected_league}
      />
    </.form>

    <div class="flex gap-4 flex-wrap items-center">
      <button
        phx-click="toggle-civ-filter"
        class={"px-4 py-2 rounded transition-colors font-medium flex items-center gap-2 " <>
          if MapSet.size(@selected_civs) < length(@civs) - 1 do
            "bg-orange-500 hover:bg-orange-600 text-white"
          else
            "bg-blue-500 hover:bg-blue-600 dark:bg-blue-600 dark:hover:bg-blue-700 text-white"
          end
        }
      >
        <.icon name="hero-funnel" class="h-5 w-5" />
        Civilizations (<%= MapSet.size(@selected_civs) %>/<%= length(@civs) - 1 %>)
      </button>

      <button
        phx-click="toggle-map-filter"
        class={"px-4 py-2 rounded transition-colors font-medium flex items-center gap-2 " <>
          if MapSet.size(@selected_maps) < length(@maps) do
            "bg-orange-500 hover:bg-orange-600 text-white"
          else
            "bg-blue-500 hover:bg-blue-600 dark:bg-blue-600 dark:hover:bg-blue-700 text-white"
          end
        }
      >
        <.icon name="hero-funnel" class="h-5 w-5" />
        Maps (<%= MapSet.size(@selected_maps) %>/<%= length(@maps) %>)
      </button>

      <%= if MapSet.size(@selected_civs) < length(@civs) - 1 or MapSet.size(@selected_maps) < length(@maps) do %>
        <button
          phx-click="reset-all-filters"
          class="px-4 py-2 bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white rounded transition-colors font-medium"
        >
          Reset All Filters
        </button>
      <% end %>
    </div>

    <%= if @show_civ_filter do %>
      <div class="border border-stone-300 dark:border-zinc-700 rounded-lg p-4 bg-stone-50 dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
            Select Civilizations (<%= MapSet.size(@selected_civs) %>/<%= length(@civs) - 1 %>)
          </h3>
          <div class="flex gap-2">
            <button
              phx-click="select-all-civs"
              class="text-sm px-3 py-1 bg-green-500 text-white rounded hover:bg-green-600"
            >
              Select All
            </button>
            <button
              phx-click="deselect-all-civs"
              class="text-sm px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600"
            >
              Clear All
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          <%= for civ <- Enum.drop(@civs, 1) do %>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-stone-100 dark:hover:bg-zinc-800 p-2 rounded">
              <input
                type="checkbox"
                phx-click="toggle-civ"
                phx-value-civ={civ.key}
                checked={MapSet.member?(@selected_civs, civ.key)}
                class="w-4 h-4"
              />
              <%= if civ.image do %>
                <img src={"/images/#{civ.image}.png"} alt={civ.label} class="w-8 h-5" />
              <% end %>
              <span class="text-sm text-stone-800 dark:text-zinc-100"><%= civ.label %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if @show_map_filter do %>
      <div class="border border-stone-300 dark:border-zinc-700 rounded-lg p-4 bg-stone-50 dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-stone-800 dark:text-zinc-100">
            Select Maps (<%= MapSet.size(@selected_maps) %>/<%= length(@maps) %>)
          </h3>
          <div class="flex gap-2">
            <button
              phx-click="select-all-maps"
              class="text-sm px-3 py-1 bg-green-500 text-white rounded hover:bg-green-600"
            >
              Select All
            </button>
            <button
              phx-click="deselect-all-maps"
              class="text-sm px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600"
            >
              Clear All
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <%= for map <- @maps do %>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-stone-100 dark:hover:bg-zinc-800 p-2 rounded">
              <input
                type="checkbox"
                phx-click="toggle-map"
                phx-value-map={map.name}
                checked={MapSet.member?(@selected_maps, map.name)}
                class="w-4 h-4"
              />
              <span class="text-sm text-stone-800 dark:text-zinc-100"><%= map.name %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%= if @error do %>
    <.error><%= @error %></.error>
  <% else %>
    <% 
      filtered_civs_list = filtered_civs(@civs, @selected_civs)
      filtered_maps_list = filtered_maps(@maps, @selected_maps)
    %>
    
    <%= if MapSet.size(@selected_civs) == 0 or MapSet.size(@selected_maps) == 0 do %>
      <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-6 text-center">
        <.icon name="hero-exclamation-triangle" class="h-12 w-12 mx-auto mb-4 text-yellow-600 dark:text-yellow-400" />
        <h3 class="text-lg font-semibold text-yellow-800 dark:text-yellow-200 mb-2">
          No Data to Display
        </h3>
        <p class="text-yellow-700 dark:text-yellow-300 mb-4">
          <%= cond do %>
            <% MapSet.size(@selected_civs) == 0 and MapSet.size(@selected_maps) == 0 -> %>
              Please select at least one civilization and one map to view data.
            <% MapSet.size(@selected_civs) == 0 -> %>
              Please select at least one civilization to view data.
            <% MapSet.size(@selected_maps) == 0 -> %>
              Please select at least one map to view data.
          <% end %>
        </p>
        <button
          phx-click="reset-all-filters"
          class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 dark:bg-yellow-500 dark:hover:bg-yellow-600 text-white rounded transition-colors font-medium"
        >
          Reset Filters
        </button>
      </div>
    <% else %>
    
    <div class="hidden md:block">
      <.table id="aoe4_civilizations" rows={filtered_maps_list}>
        <:col :let={map} label={civ_header(%{image: nil, label: "Map"})}>
          <div class="p-2 w-full h-full text-stone-800 dark:text-zinc-100">
            <%= map.name %>
          </div>
        </:col>
        <:col
          :let={map}
          :for={civ <- Enum.drop(filtered_civs_list, 1)}
          label={civ_header(%{image: civ.image, label: civ.label})}
        >
          <div class={"#{color_class(get_in(map, [:civs, civ.key, :win_rate]), :bg)} p-2 w-full h-full hover:scale-[1.15] hover:brightness-95 transition-all duration-200 ease-in-out rounded-sm"}>
            <div class="flex flex-col items-center">
              <div>
                <%= get_in(map, [:civs, civ.key, :win_rate]) || "N/A" %>
              </div>
                             <div>
                 (<%= format_number(get_in(map, [:civs, civ.key, :games_count])) %>)
               </div>
            </div>
          </div>
        </:col>
      </.table>
    </div>

    <div class="md:hidden space-y-4 w-full max-w-full">
      <%= for map <- filtered_maps_list do %>
        <div class="shadow rounded-lg overflow-hidden w-full">
          <div class="bg-zinc-100 dark:bg-stone-800  font-bold w-full">
            <%= map.name %>
          </div>
          <div class="p-4">
            <div class="grid grid-cols-3 gap-2">
              <%= for civ <- Enum.drop(filtered_civs_list, 1) do %>
                <div class="flex flex-col items-center">
                  <%= if civ.image do %>
                    <img src={"/images/#{civ.image}.png"} alt={civ.label} class="w-10 h-6 mb-1" />
                  <% end %>
                  <span class={"text-sm font-semibold #{color_class(get_in(map, [:civs, civ.key, :win_rate]), :text)}"}>
                    <%= get_in(map, [:civs, civ.key, :win_rate]) || "N/A" %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% end %>
  <% end %>
<% end %>
