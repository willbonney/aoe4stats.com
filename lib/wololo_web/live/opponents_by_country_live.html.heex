<div id="opponents-by-country">
  <%= if @loading do %>
    <div class="flex justify-center items-center w-full py-12">
      <.spinner size="lg" class="text-primary-500" />
    </div>
  <% else %>
    <%= if @error do %>
      <div class="w-full">
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-amber-800 dark:text-amber-200">
                Unable to load opponents data
              </h3>
              <div class="mt-2 text-sm text-amber-700 dark:text-amber-300">
                <%= @error %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="mx-auto w-full max-w-5xl">
        <h1 class="font-zabal text-2xl sm:text-4xl my-4 sm:my-8 mx-auto text-center text-stone-800 dark:text-zinc-100">
          Opponents by Country
        </h1>
        <p class="hidden md:block text-sm text-center text-stone-500 dark:text-zinc-400 mb-4 px-2">
          Stronger color means more of this player's opponents come from that country.
        </p>
        <p class="md:hidden text-sm text-center text-stone-500 dark:text-zinc-400 mb-4 px-2">
          Share of this player's opponents by country.
        </p>

        <div
          id="opponents-world-map"
          phx-hook="OpponentsByCountry"
          phx-update="ignore"
          data-countries={Jason.encode!(@countries)}
          class="opponents-world-map hidden md:block w-full h-[400px] lg:h-[480px] rounded-lg overflow-hidden"
        >
        </div>

        <div class="hidden md:flex items-center justify-center gap-2 mt-3 mb-6 text-xs text-stone-500 dark:text-zinc-400">
          <span>Fewer</span>
          <div class="h-2 w-28 sm:w-40 rounded-full bg-gradient-to-r from-blue-200 to-blue-800 dark:from-blue-900 dark:to-sky-300">
          </div>
          <span>More</span>
        </div>

        <ul class="divide-y divide-gray-200 dark:divide-zinc-700 rounded-lg overflow-hidden bg-white dark:bg-zinc-800 shadow">
          <%= for {{country, value}, index} <- Enum.with_index(sorted_countries(@countries), 1) do %>
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <div class="flex items-center min-w-0 gap-2">
                <span class="w-7 shrink-0 text-sm font-medium text-stone-500 dark:text-zinc-400">
                  #<%= index %>
                </span>
                <span class="text-xl shrink-0"><%= WololoWeb.PlayerLive.get_country_code_emoji(country) %></span>
                <span class="truncate text-sm font-medium text-stone-800 dark:text-zinc-100">
                  <%= country_name(country) %>
                </span>
              </div>
              <span class="shrink-0 text-sm font-semibold text-stone-800 dark:text-zinc-100">
                <%= value %>%
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
