<div class="mx-auto max-w-3xl px-2 py-6 sm:p-8">
  <div class="mx-auto max-w-3xl lg:mx-0">
    <div class="mb-2 flex flex-col items-center gap-3 sm:flex-row sm:gap-5">
      <img
        src="/images/logo.png"
        width="80"
        height="80"
        alt=""
        class="h-16 w-16 rounded-2xl shadow-lg shadow-stone-900/20 sm:h-20 sm:w-20"
      />
      <h1 class="font-zabal text-center text-4xl leading-none tracking-wide text-stone-900 dark:text-zinc-100 sm:text-5xl">
        AoE4 Stats
      </h1>
    </div>
    <div class="flex justify-center">
      <div class="w-full max-w-3xl">
        <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3 justify-items-center">
          <a
            href={~p"/civs_by_map"}
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs "
          >
            <span class="absolute border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105 dark:bg-stone-800">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100 ">
              <.icon name="hero-map" class="w-24 h-24 dark:text-zinc-100 dark:fill-slate-100" />
              Civilization WRs by Map
            </span>
          </a>
          <a
            href={~p"/civs_by_league"}
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs "
          >
            <span class="absolute border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105 dark:bg-stone-800">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100 ">
              <.icon name="hero-trophy" class="w-24 h-24 dark:text-zinc-100 dark:fill-slate-100" />
              Civilization WRs by League
            </span>
          </a>
          <button
            phx-click="show_search"
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs"
          >
            <span class="absolute  border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 dark:bg-stone-800 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100">
              <.icon name="hero-user-circle" class="w-24 h-24 dark:text-zinc-100" />
              Player Statistics
            </span>
          </button>
          <a
            href={~p"/meta"}
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs"
          >
            <span class="absolute border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 dark:bg-stone-800 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100">
              <.icon name="hero-presentation-chart-line" class="w-24 h-24 dark:text-zinc-100" />
              Pick Rate vs Win Rate
            </span>
          </a>
          <a
            href={~p"/landmarks"}
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs"
          >
            <span class="absolute border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 dark:bg-stone-800 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100">
              <svg
                class="w-24 h-24"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
                />
              </svg>
              Landmark Path
            </span>
          </a>
          <a
            href={~p"/leaderboard"}
            class="group relative rounded-2xl px-6 py-4 text-sm font-semibold leading-6 text-zinc-900 sm:py-6 w-full max-w-xs"
          >
            <span class="absolute  border-2 border-zinc-200 dark:border-stone-800 inset-0 rounded-2xl bg-zinc-50 dark:bg-stone-800 transition group-hover:bg-zinc-100 dark:group-hover:bg-stone-800 sm:group-hover:scale-105">
            </span>
            <span class="relative flex items-center gap-4 sm:flex-col dark:text-zinc-100">
              <.icon name="hero-chart-bar" class="w-24 h-24 dark:text-zinc-100" />
              Leaderboard Statistics
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
